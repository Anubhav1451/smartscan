# SmartScan Environment Variables Example
# Duplicate this file to .env and fill in real values. Never commit .env to version control.

# ==============================================================================
# FRONTEND CONFIGURATION (Vite)
# ==============================================================================
# Base URL for the FastAPI backend (e.g. http://localhost:8000 or Render URL)
VITE_API_BASE_URL=http://localhost:8000

# Supabase Public Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ==============================================================================
# BACKEND CONFIGURATION (FastAPI)
# ==============================================================================
# Supabase Project URL and Service Role Key (Backend ONLY - DO NOT EXPOSE TO FRONTEND)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Supabase Auth JWT Secret (used to verify incoming Bearer tokens)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Direct PostgreSQL Connection URL (optional for direct database tools / migrations)
DATABASE_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres

# Allowed CORS Origins (comma-separated list of origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-app.vercel.app
